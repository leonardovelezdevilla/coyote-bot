{
  "name": "coyote-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prueba": "wrangler deploy --env prueba",
    "db:crear-tablas": "wrangler d1 execute coyote-bot --remote --file=schema.sql",
    "db:crear-tablas:prueba": "wrangler d1 execute coyote-bot-prueba --remote --env prueba --file=schema.sql",
    "db:copia": "wrangler d1 export coyote-bot --remote --output=copia-coyote.sql",
    "test": "node pruebas/correr.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "qrcode-svg": "^1.1.0"
  }
}
